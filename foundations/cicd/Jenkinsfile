//     }
// }

// ─── EXAMPLE 4: Shared Library (advanced — DRY across pipelines) ─────────────
// TODO: Create a Jenkins Shared Library to reuse the Docker build/push logic.
//
// In a separate repo (jenkins-shared-lib):
//   vars/dockerBuildPush.groovy
//   def call(String imageName, String tag) {
//       sh "docker build -t ${imageName}:${tag} ."
//       sh "docker push ${imageName}:${tag}"
//   }
//
// In your Jenkinsfile:
//   @Library("jenkins-shared-lib") _
//   pipeline {
//       stages {
//           stage("Build") {
//               steps { dockerBuildPush("my-app", env.GIT_COMMIT) }
//           }
//       }
//   }

// ─── KEY CONCEPTS TO UNDERSTAND ──────────────────────────────────────────────
// agent any vs agent { docker { image "python:3.12" } }   — where the job runs
// when {}          — conditional stage execution (branch, environment, expression)
// input {}         — manual approval gate before a stage proceeds
// withCredentials  — safely inject secrets, masked in logs
// sshagent         — inject SSH key for remote deploys
// post {}          — always/success/failure/unstable blocks
// parallel {}      — run stages concurrently to speed up pipeline
// stash/unstash    — pass files between stages on different agents
// parameters       — parameterize builds (string, boolean, choice)
